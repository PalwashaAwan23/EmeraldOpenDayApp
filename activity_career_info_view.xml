<!--<?xml version="1.0" encoding="utf-8"?>-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".CareerInfo_View">

    <TextView
        android:id="@+id/textView36"
        android:layout_width="347dp"
        android:layout_height="50dp"
        android:layout_marginTop="103dp"
        android:fontFamily="@font/cabinm"
        android:gravity="center"
        android:text="@string/view_id_from_career_information_tabel"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView35"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textView73"
        android:layout_width="372dp"
        android:layout_height="108dp"
        android:layout_marginTop="103dp"
        android:fontFamily="@font/cabinm"
        android:gravity="center"
        android:text="@string/CareerView"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.589"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView35"
        app:layout_constraintVertical_bias="0.907" />

    <TextView
        android:id="@+id/textView35"
        android:layout_width="226dp"
        android:layout_height="78dp"
        android:fontFamily="@font/cabinm"
        android:gravity="center"
        android:text="@string/wlv_open_day_database16"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.231" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="305dp"
        android:layout_height="182dp"
        app:srcCompat="@drawable/bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="-16dp"
        android:layout_marginTop="-2dp" />


    <Button
        android:id="@+id/button4"
        android:layout_width="322dp"
        android:layout_height="54dp"
        android:backgroundTint="#48444E"
        android:fontFamily="@font/cabinm"
        android:text="@string/view4"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etPassword2"
        app:layout_constraintVertical_bias="0.351" />

    <EditText
        android:id="@+id/etPassword2"
        android:layout_width="375dp"
        android:layout_height="50dp"
        android:autofillHints=""
        android:background="@drawable/edittext_outline"
        android:fontFamily="@font/cabinm"
        android:hint="@string/career_info_id5"
        android:inputType="textPassword"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.555"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView36"
        app:layout_constraintVertical_bias="0.066" />

    <EditText
        android:id="@+id/etPassword12"
        android:layout_width="375dp"
        android:layout_height="50dp"
        android:autofillHints=""
        android:background="@drawable/edittext_outline"
        android:fontFamily="@font/cabinm"
        android:hint="@string/career_name"
        android:inputType="textPassword"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.555"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView36"
        app:layout_constraintVertical_bias="0.29" />


</androidx.constraintlayout.widget.ConstraintLayout>