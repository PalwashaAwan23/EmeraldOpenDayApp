<!--<?xml version="1.0" encoding="utf-8"?>-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".EmailLogin">

<!--    <?xml version="1.0" encoding="utf-8"?>-->

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="169dp"
        android:layout_height="332dp"
        android:src="@drawable/colll"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="-7dp"
        tools:layout_editor_absoluteY="0dp" />

    <TextView
        android:id="@+id/textView71"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cabinm"
        android:gravity="center"
        android:text="@string/login_with_email"
        android:textColor="#48444E"
        android:textSize="50sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.166" />


    <TextView
        android:id="@+id/textView5"
        android:layout_width="324dp"
        android:layout_height="112dp"
        android:fontFamily="@font/cabinm"
        android:gravity="center"
        android:text="@string/we_ll_email_you_a_magic_link_code_for_a_password_free_sign_in_or_you_can_sign_in_manually_instead"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView71"
        app:layout_constraintVertical_bias="0.18" />

    <Button
        android:id="@+id/button4"
        android:layout_width="322dp"
        android:layout_height="54dp"
        android:backgroundTint="#48444E"
        android:fontFamily="@font/cabinm"
        android:text="@string/login"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etPassword2"
        app:layout_constraintVertical_bias="0.178" />

    <EditText
        android:id="@+id/etPassword2"
        android:layout_width="375dp"
        android:layout_height="50dp"
        android:autofillHints=""
        android:background="@drawable/edittext_outline"
        android:fontFamily="@font/cabinm"
        android:hint="@string/l_hundal_wlv_ac_uk"
        android:inputType="textPassword"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5"
        app:layout_constraintVertical_bias="0.038" />

</androidx.constraintlayout.widget.ConstraintLayout>

