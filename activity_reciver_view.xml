<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="1">

        <!-- Profile Image with subtle background -->
        <androidx.cardview.widget.CardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="2dp"
            android:layout_gravity="center"
            android:backgroundTint="#E0EAEF"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <androidx.cardview.widget.CardView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:fontFamily="@font/cabinm"
                android:layout_margin="2dp"
                app:cardCornerRadius="26dp"
                app:cardBackgroundColor="@color/light_gray"
                app:cardElevation="4dp">

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/emeralds" />
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>

        <!-- Message Bubble -->
        <TextView
            android:id="@+id/receiver_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/cabinm"
            android:background="@drawable/receiver_message_background"
            android:padding="14dp"
            android:text="Hi, I'm Jeffrey, a University of Wolverhampton Open Day helper. How can I assist you today? 😊"
            android:textColor="#000000"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Time with Blue Background -->
    <TextView
        android:id="@+id/receiver_time"
        android:layout_width="64dp"
        android:layout_height="26dp"
        android:layout_below="@+id/time"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="100dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="257dp"
        android:fontFamily="@font/cabinm"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="9:30 PM"
        android:textColor="#000000"
        android:textSize="12sp" />
</RelativeLayout>




