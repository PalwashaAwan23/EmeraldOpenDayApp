<!--<?xml version="1.0" encoding="utf-8"?>-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Modules_View">

    <TextView
        android:id="@+id/textView69"
        android:layout_width="347dp"
        android:layout_height="50dp"
        android:fontFamily="@font/cabinm"
        android:gravity="center"
        android:text="@string/view_id_from_modules_tabel"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView68"
        app:layout_constraintVertical_bias="0.106" />

    <TextView
        android:id="@+id/textView72"
        android:layout_width="323dp"
        android:layout_height="138dp"
        android:fontFamily="@font/cabinm"
        android:gravity="center"
        android:text="@string/ModuleView"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.488"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView68"
        app:layout_constraintVertical_bias="0.956" />

    <TextView
        android:id="@+id/textView68"
        android:layout_width="226dp"
        android:layout_height="78dp"
        android:fontFamily="@font/cabinm"
        android:gravity="center"
        android:text="@string/wlv_open_day_database31"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.231" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="305dp"
        android:layout_height="182dp"
        app:srcCompat="@drawable/bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="-16dp"
        android:layout_marginTop="-2dp" />


    <Button
        android:id="@+id/button4"
        android:layout_width="322dp"
        android:layout_height="54dp"
        android:backgroundTint="#48444E"
        android:fontFamily="@font/cabinm"
        android:text="@string/view11"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etPassword2"
        app:layout_constraintVertical_bias="0.415" />

    <EditText
        android:id="@+id/etPassword2"
        android:layout_width="375dp"
        android:layout_height="50dp"
        android:autofillHints=""
        android:background="@drawable/edittext_outline"
        android:fontFamily="@font/cabinm"
        android:hint="@string/modules_id"
        android:inputType="textPassword"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.555"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView69"
        app:layout_constraintVertical_bias="0.093" />

    <EditText
        android:id="@+id/etPassword10"
        android:layout_width="375dp"
        android:layout_height="50dp"
        android:autofillHints=""
        android:background="@drawable/edittext_outline"
        android:fontFamily="@font/cabinm"
        android:hint="@string/modules_name"
        android:inputType="textPassword"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.555"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView69"
        app:layout_constraintVertical_bias="0.316" />


</androidx.constraintlayout.widget.ConstraintLayout>