<!--<?xml version="1.0" encoding="utf-8"?>-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".faculties">

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="169dp"
        android:layout_height="332dp"
        android:src="@drawable/colll"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="-7dp"
        tools:layout_editor_absoluteY="0dp" />


    <Button
        android:id="@+id/mathsCompsci"
        android:layout_width="345dp"
        android:layout_height="101dp"
        android:layout_marginBottom="220dp"
        android:background="@android:color/transparent"
        android:fontFamily="@font/cabinm"
        android:text="@string/mathematics_and_computer_science"
        android:textColor="#48444E"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/contactUs"
        android:layout_width="345dp"
        android:layout_height="101dp"
        android:layout_marginBottom="56dp"
        android:background="@android:color/transparent"
        android:fontFamily="@font/cabinm"
        android:text="@string/contact_us_on"
        android:textColor="#48444E"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/Engineering"
        android:layout_width="344dp"
        android:layout_height="92dp"
        android:layout_marginBottom="368dp"
        android:background="@android:color/transparent"
        android:fontFamily="@font/cabinm"
        android:text="@string/engineering"
        android:textColor="#48444E"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="164dp"
        android:layout_height="54dp"
        android:fontFamily="@font/cabinm"
        android:gravity="center"
        android:text="@string/faculties"
        android:textSize="40sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.191" />

</androidx.constraintlayout.widget.ConstraintLayout>